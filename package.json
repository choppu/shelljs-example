{
  "name": "shelljs-example",
  "version": "2.0.0",
  "description": "Test page for ShellJS and ShellJS WebHID",
  "private": true,
  "scripts": {
    "start": "parcel src/index.html",
    "build": "parcel build src/index.html",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "predeploy": "rm -rf dist && parcel build src/index.html --no-source-maps --public-url  https://choppu.github.io/shelljs-example/",
    "deploy": "gh-pages -d dist"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@choppu/shelljs": "^2.0.0",
    "@choppu/shelljs-web-hid": "^2.0.0",
    "@ethereumjs/util": "^10.1.3",
    "@metamask/eth-sig-util": "^7.0.2",
    "@noble/secp256k1": "^3.2.0",
    "js-sha3": "^0.14.0"
  },
  "devDependencies": {
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "gh-pages": "^6.3.0",
    "https-browserify": "^1.0.0",
    "parcel": "^2.16.4",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "typescript": "^6.0.3",
    "url": "^0.11.4",
    "util": "^0.12.5"
  },
